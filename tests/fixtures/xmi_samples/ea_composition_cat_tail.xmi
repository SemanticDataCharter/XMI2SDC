				<model ea_localid="6915"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Component(s).Tail -[is part of]-&amp;gt; Cat.Whole.&#xA;&#xA;Tail end — role: Component, multiplicity 0..1&#xA;(a Cat has at most one Tail (1) — multiple tails are out of scope —&#xA;but tailless cats do exist, hence the lower bound of 0.)&#xA;&#xA;Cat end — role: Composite, multiplicity 1 (default, not shown)&#xA;(a Tail belongs to exactly one Cat — always.&#xA;A Tail cannot exist without its Cat.)&#xA;&#xA;Composition semantics (filled diamond):&#xA;This is a composite aggregation — the strongest ownership in UML.&#xA;The Tail cannot exist independently of the Cat:&#xA;if the Cat is put outside, the Tail goes with it.&#xA;If you see a tail in the doorway and pull it,&#xA;a meowing Cat will inevitably follow.&#xA;A Tail may belong to at most one Cat at any point in time.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..1" lt="+Component" mt="is an inseparable part of" rt="+Composite"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
		</connectors>
