				<model ea_localid="6921"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: FieldReplaceablePart(s).Belt -[is part of]-&gt; CuttingDeck(s).PartCarrier.&#xA;&#xA;Belt end — role: Field-Replaceable Part, multiplicity 0..2&#xA;(a CuttingDeck may carry no belt (0) — e.g. during replacement —&#xA;one belt on a standard deck (1),&#xA;or two belts on a dual-drive deck (2).)&#xA;&#xA;CuttingDeck end — role: Part Carrier, multiplicity 0..1&#xA;(a Belt belongs to at most one CuttingDeck at a time,&#xA;or exists freely as a spare in the barn or workshop (0).)&#xA;&#xA;Aggregation semantics (hollow diamond):&#xA;The Belt is a Line-Replaceable Unit (LRU) — the farmer replaces it in the field.&#xA;A Belt can exist independently of any CuttingDeck.&#xA;Note: the same Belt class is also used in the Transmission (see separate association).&#xA;This reflects that the same belt type may be fitted to either assembly,&#xA;though one physical belt can only be in one place at a time.&#xA;&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..2" lt="+Field-Replaceable Part" mt="is part of" rb="0..1" rt="+Part Carrier"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
