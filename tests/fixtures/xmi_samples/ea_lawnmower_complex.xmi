				<model ea_localid="6922"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: FieldReplaceablePart(s).Belt -[is part of]-&gt; Transmission(s).PartCarrier.&#xA;&#xA;Belt end — role: Field-Replaceable Part, multiplicity 0..2&#xA;(a Transmission may carry no belt (0), one belt (1), or two belts (2).)&#xA;&#xA;Transmission end — role: Part Carrier, multiplicity 0..1&#xA;(a Belt belongs to at most one Transmission at a time,&#xA;or exists freely as a spare (0).)&#xA;&#xA;Aggregation semantics (hollow diamond):&#xA;The Belt is a Line-Replaceable Unit (LRU).&#xA;The same belt type that fits the CuttingDeck also fits the Transmission.&#xA;This shared aggregation models that interchangeability explicitly.&#xA;&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..2" lt="+Field-Replaceable Part" mt="is part of" rb="0..1" rt="+Part Carrier"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
