				<model ea_localid="6912"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Part(s).Belt -[is part of]-&gt; LawnMower(s).Aggregate.&#xA;&#xA;Belt end — role: Part, multiplicity 0..2&#xA;(a LawnMower may have no belt fitted at all — e.g. during maintenance (0),&#xA;one belt on a single-deck mower (1),&#xA;or two belts on a dual-deck mower (2).&#xA;The upper bound of 2 reflects the maximum of two cutting decks&#xA;a typical mower configuration supports.)&#xA;&#xA;LawnMower end — role: Aggregate, multiplicity 0..1&#xA;(a Belt either belongs to exactly one LawnMower (1),&#xA;or exists independently — stored as a spare part in the barn,&#xA;awaiting installation, or just delivered from Amazon (0).)&#xA;&#xA;Aggregation semantics:&#xA;This is a shared aggregation (hollow diamond), not composition.&#xA;The Belt exists independently of any LawnMower —&#xA;it may be a spare part in stock, a belt being replaced,&#xA;or a belt type shared across different mower models.&#xA;Destroying the LawnMower does not destroy the Belt.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..2" lt="+Part" mt="is part of" rb="0..1" rt="+Aggregate"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
			<connector xmi:idref="EAID_B21F742F_5078_44E1_A629_0F6CBC27D3E0" name="is part of">
				<source xmi:idref="EAID_770BE2F0_B7E3_4C69_BF3F_7E6E71B6A7BB">
