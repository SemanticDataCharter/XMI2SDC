				<model ea_localid="6913"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Part(s).Blade -[is part of]-&amp;gt; LawnMower(s).Aggregate.&#xA;&#xA;Blade end — role: Part, multiplicity 0..2&#xA;(a LawnMower may have no blade fitted — e.g. during servicing (0),&#xA;one blade on a single-deck mower (1),&#xA;or two blades on a dual-deck mower (2).&#xA;The upper bound of 2 reflects the maximum of two cutting decks&#xA;a typical mower configuration supports.)&#xA;&#xA;LawnMower end — role: Aggregate, multiplicity 0..1&#xA;(a Blade either belongs to exactly one LawnMower (1),&#xA;or exists independently — stored as a replacement blade in the barn,&#xA;being sharpened, or just delivered from Amazon (0).)&#xA;&#xA;Aggregation semantics:&#xA;This is a shared aggregation (hollow diamond), not composition.&#xA;The Blade exists independently of any LawnMower —&#xA;it may be a spare blade in storage, a blade being sharpened,&#xA;or a blade type compatible with multiple mower models.&#xA;Destroying the LawnMower does not destroy the Blade.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..2" lt="+Part" mt="is part of" rb="0..1" rt="+Aggregate"/>
				<extendedProperties/>
				<style/>
