					<model ea_localid="8670" type="Class" name="LawnMower"/>
					<role name="Aggregate" visibility="Public"/>
					<type multiplicity="0..1" aggregation="shared"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
