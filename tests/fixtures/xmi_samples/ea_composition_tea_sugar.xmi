				<model ea_localid="6916"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Component(s).SugarPortion -[is dissolved in]-&amp;gt; TeaPortion.Whole.&#xA;&#xA;SugarPortion end — role: Component, multiplicity 0..1&#xA;(a TeaPortion contains at most one SugarPortion (1) —&#xA;we model a single dissolved serving, not granules —&#xA;but unsweetened tea is perfectly valid, hence the lower bound of 0.)&#xA;&#xA;TeaPortion end — role: Composite, multiplicity 1 (default, not shown)&#xA;(a dissolved SugarPortion belongs to exactly one TeaPortion.&#xA;Once dissolved, it cannot exist independently.)&#xA;&#xA;Composition semantics (filled diamond):&#xA;This is a composite aggregation — the strongest ownership in UML.&#xA;The SugarPortion cannot exist independently of the TeaPortion&#xA;once it has been dissolved:&#xA;drinking the tea means consuming the sugar along with it.&#xA;There is no natural way to separate the sugar back out —&#xA;you would have to discard the entire TeaPortion.&#xA;A dissolved SugarPortion may belong to at most one TeaPortion&#xA;at any point in time.&#xA;&#xA;Note: in a later extension of this model, TeaPortion will be&#xA;aggregated (hollow diamond, shared) into a GlassOfTea,&#xA;because tea can be poured into a different glass,&#xA;or split across two glasses to cool faster.&#xA;That relationship will be modelled as aggregation, not composition.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..1" lt="+Component" mt="is an inseparable part of" rt="+Composite"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
		</connectors>
