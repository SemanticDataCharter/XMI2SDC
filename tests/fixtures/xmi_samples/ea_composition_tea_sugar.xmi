				<target xmi:idref="EAID_A5DB85F4_FEE9_40D5_BE7B_F0B0EB9FBCFB">
					<model ea_localid="8683" type="Class" name="TeaPortion"/>
					<role name="Composite" visibility="Public"/>
					<type aggregation="composite"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
