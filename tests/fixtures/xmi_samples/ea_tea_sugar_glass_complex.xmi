		<connectors>
			<connector xmi:idref="EAID_32FA0D83_B99D_4CDE_843D_F596C0F0B15B" name="is poured into">
				<source xmi:idref="EAID_C8A1303F_832C_4D70_B3D6_CAD2CC0DD115">
					<model ea_localid="8687" type="Class" name="TeaPortion"/>
					<role name="Content" visibility="Public"/>
					<type multiplicity="0..1" aggregation="none"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
					<style value="Owned=0;Navigable=Unspecified;"/>
					<documentation/>
					<xrefs/>
					<tags/>
				</source>
				<target xmi:idref="EAID_5547F9B9_7F6B_432B_AB75_A6F6C574AADA">
					<model ea_localid="8689" type="Class" name="Glass"/>
					<role name="Vessel" visibility="Public"/>
					<type multiplicity="1..*" aggregation="shared"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
					<style value="Owned=0;Navigable=Unspecified;"/>
					<documentation/>
					<xrefs/>
					<tags/>
				</target>
				<model ea_localid="6918"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Content(s).TeaPortion -[is poured into]-&gt; Glass(es).Vessel.&#xA;&#xA;TeaPortion end — role: Content, multiplicity 0..1&#xA;(a Glass may be empty (0),&#xA;or contain exactly one TeaPortion (1).&#xA;A glass holds one portion at a time.)&#xA;&#xA;Glass end — role: Vessel, multiplicity 1..*&#xA;(a TeaPortion must be poured into at least one Glass —&#xA;a portion of tea that has never been poured into any glass&#xA;does not make practical sense (lower bound 1).&#xA;But it may also be split across two glasses to cool faster (upper bound *).)&#xA;&#xA;Aggregation semantics (hollow diamond):&#xA;This is a shared aggregation, not composition.&#xA;Tea can be poured from one Glass into another,&#xA;or split across several glasses.&#xA;The TeaPortion exists independently of any particular Glass —&#xA;the Glass is just the vessel, not the owner.&#xA;&#xA;Contrast with the SugarPortion:&#xA;sugar dissolved in the tea is a composition —&#xA;it cannot be separated from the TeaPortion under any normal circumstance.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..1" lt="+Content" mt="is poured into" rb="1..*" rt="+Vessel"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
			<connector xmi:idref="EAID_02011812_67E0_4440_81E9_E2B7836B2091" name="is an inseparable part of">
				<source xmi:idref="EAID_870C07DC_A6D8_470C_95EF_333FE85D85D2">
					<model ea_localid="8688" type="Class" name="SugarPortion"/>
					<role name="Component" visibility="Public"/>
					<type multiplicity="0..1" aggregation="none"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
					<style value="Owned=0;Navigable=Unspecified;"/>
					<documentation/>
					<xrefs/>
					<tags/>
				</source>
				<target xmi:idref="EAID_C8A1303F_832C_4D70_B3D6_CAD2CC0DD115">
					<model ea_localid="8687" type="Class" name="TeaPortion"/>
					<role name="Composite" visibility="Public"/>
					<type aggregation="composite"/>
					<constraints/>
					<modifiers isOrdered="false" isNavigable="false"/>
					<style value="Owned=0;Navigable=Unspecified;"/>
					<documentation/>
					<xrefs/>
					<tags/>
				</target>
				<model ea_localid="6917"/>
				<properties ea_type="Association" direction="Unspecified"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="Reading: Component(s).SugarPortion -[is an inseparable part of]-&gt; TeaPortion.Composite.&#xA;&#xA;SugarPortion end — role: Component, multiplicity 0..1&#xA;(a TeaPortion contains at most one SugarPortion —&#xA;unsweetened tea is perfectly valid, hence the lower bound of 0.)&#xA;&#xA;TeaPortion end — role: Composite, multiplicity 1 (default, not shown)&#xA;(a dissolved SugarPortion belongs to exactly one TeaPortion.&#xA;Once dissolved, it cannot exist independently.)&#xA;&#xA;Composition semantics (filled diamond):&#xA;Once sugar is dissolved in tea, it cannot be separated back out&#xA;by any natural means.&#xA;When the tea is drunk, the sugar is consumed along with it.&#xA;A dissolved SugarPortion may belong to at most one TeaPortion&#xA;at any point in time.&#xA;&#xA;Direction of reading is shown on the diagram by a filled triangle&#xA;next to the association name label.&#xA;The association direction itself is Unspecified."/>
				<appearance linemode="3" linecolor="0" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..1" lt="+Component" mt="is an inseparable part of" rt="+Composite"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
		</connectors>
