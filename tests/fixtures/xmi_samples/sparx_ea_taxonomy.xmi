        </elements>
        <connectors>
            <connector xmi:idref="EAID_assoc_01">
                <source xmi:idref="EAID_CAT_01">
                    <model ea_localid="2" type="Class" name="1.0 Develop Vision and Strategy"/>
                    <type multiplicity="1" aggregation="composite" containment="Unspecified"/>
